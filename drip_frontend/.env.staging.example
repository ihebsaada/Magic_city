# Public frontend configuration only. Replace before a staging build.
# No DATABASE_URL, JWT_SECRET, Stripe secret or password belongs in VITE_*.
VITE_API_URL=https://backend.staging.example.invalid/api
VITE_CHECKOUT_ORIGIN=https://checkout.staging.example.invalid
# Remote Netlify uses the historical manual handoff; omit VITE_COMMON_CHECKOUT_ENABLED.

# Automatic cross-origin guest handoff; popup failures remain explicit.
VITE_AUTOMATIC_HANDOFF=false

VITE_NAVIGATION_HANDOFF_ENABLED=true
