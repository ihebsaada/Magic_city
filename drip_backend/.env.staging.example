# Template only. Replace placeholders in the NEW Render service, never production.
DEPLOYMENT_ENV=staging
NODE_ENV=production
NODE_VERSION=24.19.0
# PORT is supplied by Render; do not copy the local port.
DATABASE_URL=postgresql://STAGING_USER:REPLACE_SECRET@STAGING_HOST/magiccity_db_staging?sslmode=require
STAGING_DATABASE_HOST=STAGING_HOST
JWT_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1h
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_DEDICATED_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_DEDICATED_TEST_WEBHOOK_SECRET
STRIPE_CURRENCY=eur
# STRIPE_API_VERSION must remain UNSET: staging rejects overrides.
# HTTPS origins only, no paths. These are intentionally non-operational examples.
STAGING_STORE_ORIGIN=https://store.staging.example.invalid
STAGING_CHECKOUT_ORIGIN=https://checkout.staging.example.invalid
STAGING_API_ORIGIN=https://backend.staging.example.invalid
# Historical separate-origin example; no trailing slash.
CHECKOUT_APP_URL=https://checkout.staging.example.invalid
STRIPE_SUCCESS_URL=https://checkout.staging.example.invalid/order-confirmation?orderId={ORDER_ID}&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://checkout.staging.example.invalid/checkout-landing?orderId={ORDER_ID}
# ADMIN_EMAIL / ADMIN_PASSWORD are NOT runtime authentication configuration.
# They are seed inputs only. Do not run seed against the restored database.
# Future explicitly authorized provisioning would use distinct synthetic values:
# ADMIN_EMAIL=admin-staging@example.invalid
# ADMIN_PASSWORD=REPLACE_WITH_DISTINCT_STAGING_PASSWORD

# Dedicated staging key for encrypted navigation tickets; keep stable while tickets exist.
NAVIGATION_HANDOFF_SECRET=REPLACE_WITH_NEW_RANDOM_STAGING_KEY_AT_LEAST_32_CHARACTERS
